rules_version = '2';

// DEVBEAST OS security rules.
//
// Every record lives under `users/{uid}`, so ownership is structural: a request
// can only ever touch documents whose path contains the caller's own uid. There
// is no collection-group read path, so a crafted query cannot reach another
// user's data either.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // `userId` is denormalised onto records for exports; when present it must
    // agree with the path, so it can never be used to impersonate another user.
    function userIdMatches(uid) {
      return !('userId' in request.resource.data)
        || request.resource.data.userId == uid;
    }

    function isDateKey(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    // ---- user profile -----------------------------------------------------
    match /users/{uid} {
      allow get, list: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string;

      allow update: if isOwner(uid)
        // The uid on the document can never be repointed.
        && request.resource.data.uid == resource.data.uid
        && (!('name' in request.resource.data) || request.resource.data.name.size() <= 120);

      allow delete: if isOwner(uid);

      // ---- generic owned subcollections ----------------------------------
      match /categories/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && userIdMatches(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60;
      }

      match /tasks/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && userIdMatches(uid)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 300
          && request.resource.data.status in ['not_started', 'in_progress', 'completed', 'skipped']
          && request.resource.data.priority in ['low', 'medium', 'high', 'critical']
          && (request.resource.data.scheduledDate == null
              || isDateKey(request.resource.data.scheduledDate));
      }

      match /habits/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && userIdMatches(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.measurementType in ['binary', 'count', 'duration']
          && isDateKey(request.resource.data.startDate);
      }

      match /habitLogs/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && userIdMatches(uid)
          && request.resource.data.habitId is string
          && isDateKey(request.resource.data.date)
          && request.resource.data.status in ['completed', 'partial', 'skipped', 'missed']
          && request.resource.data.value is number
          // The log id is deterministic, which is what stops duplicate day rows.
          && docId == request.resource.data.habitId + '_' + request.resource.data.date;
      }

      match /subjects/{subjectId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && userIdMatches(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120;

        match /topics/{topicId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && userIdMatches(uid)
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 200
            && request.resource.data.status in
                 ['not_started', 'learning', 'practice', 'revision', 'completed'];
        }
      }

      match /studySessions/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && userIdMatches(uid)
          && isDateKey(request.resource.data.date)
          && request.resource.data.durationMinutes is number
          && request.resource.data.durationMinutes >= 0
          && request.resource.data.durationMinutes <= 1440;
      }

      match /activityLogs/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && userIdMatches(uid)
          && isDateKey(request.resource.data.date)
          && request.resource.data.durationMinutes is number
          && request.resource.data.durationMinutes >= 0
          && request.resource.data.durationMinutes <= 1440;
      }

      match /goals/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && userIdMatches(uid)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 300
          && request.resource.data.status in ['active', 'completed', 'paused', 'archived']
          && request.resource.data.progress is number
          && request.resource.data.progress >= 0
          && request.resource.data.progress <= 100;
      }

      // Aggregates and reviews are keyed by the local date / week they describe.
      match /dailyStats/{dateKey} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && userIdMatches(uid)
          && isDateKey(dateKey)
          && request.resource.data.date == dateKey
          && request.resource.data.productivityScore is number
          && request.resource.data.productivityScore >= 0
          && request.resource.data.productivityScore <= 100
          && request.resource.data.dayState in ['successful', 'incomplete', 'rest', 'no_data'];
      }

      match /dailyReviews/{dateKey} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && userIdMatches(uid)
          && isDateKey(dateKey)
          && request.resource.data.date == dateKey;
      }

      match /weeklyReviews/{weekId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && userIdMatches(uid)
          && isDateKey(request.resource.data.weekStart)
          && isDateKey(request.resource.data.weekEnd);
      }

      match /reflections/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && userIdMatches(uid)
          && isDateKey(request.resource.data.date)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000;
      }

      // Anything not explicitly matched above stays denied.
      match /{unknown=**} {
        allow read, write: if false;
      }
    }

    // No document outside `users/{uid}` is readable or writable by anyone.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
